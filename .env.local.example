# Copy this file to .env.local and fill in real values. Never commit .env.local.

# AI provider selection. Leave empty to auto pick the first provider that has a key,
# preferring Groq for development. Valid values: groq, anthropic, openai, openrouter, mock.
AI_PROVIDER=

# Groq. The default development provider. Free tier, no credit card. Get a key at console.groq.com.
GROQ_API_KEY=
# Best overall quality on the free tier, with strict structured outputs for reliable state.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Anthropic. Optional. Switch to this by setting AI_PROVIDER=anthropic and a key here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI. Optional. Uses the same OpenAI compatible provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_BASE_URL=https://api.openai.com/v1

# OpenRouter. Optional. One key, many models, same OpenAI compatible provider.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase. Required for cloud persistence. From your project settings.
# Both must be set to activate Supabase. If either is missing the app uses a local file store.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Owner view password. Required to open /admin.
ADMIN_PASSWORD=
